APP_ENV=production
LOG_LEVEL=INFO

# Postgres password used by Compose (postgres service + api DATABASE_URL).
POSTGRES_PASSWORD=pms

# Host-side tools only (make docker-up postgres-only / local uv). When using full
# Compose, the api container ignores this and uses host `postgres` instead.
DATABASE_URL=postgresql+psycopg://pms:pms@localhost:5433/pms

RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
# Host-only default for non-Docker workflows.
EXTERNAL_DATA_DIR=./data/external
EXPORT_DIR=./data/exports
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
FUNDAMENTALS_PROVIDER=manual
# Options: manual | screener | yahoo | xbrl (BSE TabResults + XBRL backfill)

# REQUIRED for docker compose: absolute path to the Research folder that
# contains Portfolio/ (not Portfolio itself).
#
# macOS example:
# RESEARCH_DIR=/Users/you/Library/CloudStorage/OneDrive-Personal/Research
#
# Windows example (Docker Desktop):
# RESEARCH_DIR=C:/Users/Dad/OneDrive/Some/Nested/Path/Research
#
# Forward slashes work on Windows in .env files.
RESEARCH_DIR=

# Optional: host folder with TRANSACTIONS_MASTER_*.xlsx and SECURITY_MASTER_V1.xlsx.
# Default in Compose: ./docker/final_master_seed (shipped with the repo).
# FINAL_MASTER_DIR=C:/Users/Dad/OneDrive/PMS-Decision-Platform/02_Final_Master

# Optional for Docker on Dad laptop: OneDrive external market-data folder.
# Refresh prefers this path and falls back to ./docker/market_data_seed.
# ONEDRIVE_EXTERNAL_DATA_DIR=C:/Users/Dad/OneDrive/.../PMS-Decision-Platform/05_External_Data

# Browser on the same machine as Docker (Dad laptop / local).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
