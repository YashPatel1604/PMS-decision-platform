APP_ENV=production

# Postgres password used by Compose (postgres service + api DATABASE_URL).
POSTGRES_PASSWORD=pms

# Host-side tools only (make docker-up postgres-only / local uv). When using full
# Compose, the api container ignores this and uses host `postgres` instead.
DATABASE_URL=postgresql+psycopg://pms:pms@localhost:5433/pms

RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
# Host-only default for non-Docker workflows.
EXTERNAL_DATA_DIR=./data/external
EXPORT_DIR=./data/exports
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
FUNDAMENTALS_PROVIDER=manual
# Options: manual | screener | yahoo | xbrl (BSE TabResults + XBRL backfill)

# Optional. Full install: path to Research (folder that contains Portfolio/).
# Client-only PCs can leave this empty (Compose mounts an empty stub).
#
# macOS example:
# RESEARCH_DIR=/Users/you/Library/CloudStorage/OneDrive-Personal/Research
#
# Windows example (Docker Desktop):
# RESEARCH_DIR=C:/Users/Dad/OneDrive/Some/Nested/Path/Research
#
# Forward slashes work on Windows in .env files.
RESEARCH_DIR=

# Writable Client books (sibling DailyEditFiles). Docker default: ../DailyEditFiles
# Put here: Charts*.xlsx, SCA_LLP*.xlsx, PMS_ClientPortfolio*.xlsx, PivotPoints*.xlsx
# DAILY_EDIT_DIR=/Users/you/Library/CloudStorage/OneDrive-Personal/PMS-Decision-Platform/DailyEditFiles

# Optional: host folder with TRANSACTIONS_MASTER_*.xlsx and SECURITY_MASTER_V1.xlsx.
# Default in Compose: ./docker/final_master_seed (shipped with the repo).
# FINAL_MASTER_DIR=C:/Users/Dad/OneDrive/PMS-Decision-Platform/02_Final_Master

# Optional for Docker on Dad laptop: OneDrive external market-data folder.
# Refresh prefers this path and falls back to ./docker/market_data_seed.
# ONEDRIVE_EXTERNAL_DATA_DIR=C:/Users/Dad/OneDrive/.../PMS-Decision-Platform/05_External_Data

# Browser talks to the UI; the UI proxies /backend → API (keeps the login cookie).
# In Docker, API_INTERNAL_URL must be the compose service name — NOT 127.0.0.1.
NEXT_PUBLIC_API_URL=/backend
API_INTERNAL_URL=http://api:8000

# --- Auth (invite-only) ---
# Login is on by default (Julesh / Samir). Set AUTH_DISABLED=1 to skip login locally.
AUTH_DISABLED=0
AUTH_SECRET=local-dev-pms-auth-secret-change-me
# AUTH_COOKIE_SECURE=0
# AUTH_SESSION_MAX_AGE_SECONDS=1209600
# Extra CORS origins (comma-separated), e.g. http://100.x.x.x:3000
# CORS_ORIGINS=

# --- Research analyst / Grok (optional) ---
# Snippets only are sent to xAI — never whole PDFs. Leave blank to keep FTS-only.
# XAI_API_KEY=
# XAI_API_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-2-latest
# RESEARCH_INDEX_ENABLED=1
# RESEARCH_CORPUS_GLOBS=**/*.pdf,**/*.md,**/*.txt
# RESEARCH_CORPUS_EXCLUDE_GLOBS=**/~*,**/.tmp/**
# RESEARCH_RAG_MAX_CHUNKS=8
# RESEARCH_RAG_MAX_CONTEXT_TOKENS=4000
# RESEARCH_RAG_SNIPPET_CHARS=1200
# RESEARCH_ANSWER_CACHE_TTL_DAYS=30
# RESEARCH_PROMPT_RETENTION_DAYS=0
# RESEARCH_ANALYST_PROMPT_VERSION=v1
